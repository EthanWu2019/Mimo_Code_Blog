# Database (local dev uses docker compose; production uses Neon)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require"

# Redis (optional - not needed for Vercel)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-string-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resume LaTeX compile backend. Default is the public LaTeXOnline open-source
# wrapper around pdflatex. Swap to a self-hosted runner if you need full data
# residency. Endpoint contract: POST multipart/form-data with files[] field.
RESUME_LATEX_URL="https://latex.ytotech.com/builds/sync"
